{
  "schema": {
    "open_app": {"name": "string (app name as spoken, e.g. firefox)"},
    "close_window": {},
    "close_all_windows": {},
    "set_volume": {"percent": "int 0-100 (mute = 0)"},
    "change_volume": {"delta": "int, e.g. +10 or -10"},
    "set_brightness": {"percent": "int 0-100"},
    "change_brightness": {"delta": "int"},
    "toggle_dark_mode": {"enable": "bool or null to toggle"},
    "toggle_dnd": {"enable": "bool or null to toggle"},
    "toggle_wifi": {"enable": "bool"},
    "toggle_bluetooth": {"enable": "bool"},
    "switch_workspace": {"n": "int (1-based) or 'next' / 'prev'"},
    "screenshot": {"target": "screen | window | area"},
    "lock": {},
    "power": {"action": "suspend | reboot | shutdown | logout", "needs_confirmation": "always true"},
    "run_shell": {"command": "string", "needs_confirmation": "bool: true if the command modifies the system, deletes, installs, uses sudo, or is not read-only"},
    "answer": {"text": "string: short reply to a question that needs no command"},
    "unknown": {}
  },
  "notes": "accept: list of alternative acceptable expectations. For run_shell, command_keywords must all appear (case-insensitive) in the command. For open_app, name_any is a list of accepted normalised names. trap=true marks the adversarial cases.",
  "items": [
    {"id": 1, "lang": "fr", "text": "euh ouvre moi firefox", "expect": {"action": "open_app", "name_any": ["firefox"]}},
